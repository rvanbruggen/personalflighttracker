# ============================================================================
# Personal Flight Tracker — configuration
# Copy to .env and fill in.  .env is gitignored: never commit real secrets.
#   cp .env.example .env
# ============================================================================

# --- AeroDataBox via RapidAPI (flight status) -------------------------------
# 1. Sign up at https://rapidapi.com/
# 2. Subscribe to AeroDataBox, Basic (free) plan:
#    https://rapidapi.com/aedbx-aedbx/api/aerodatabox/pricing
# 3. Copy your RapidAPI key ("X-RapidAPI-Key") here.
AERODATABOX_API_KEY=
AERODATABOX_HOST=aerodatabox.p.rapidapi.com

# Free tier is ~600 units/month and a status call costs 2 units. The app stops
# polling rather than overrunning this — lower it if you share the key.
AERODATABOX_MONTHLY_UNIT_BUDGET=600
AERODATABOX_UNITS_PER_STATUS_CALL=2
AERODATABOX_MIN_SECONDS_BETWEEN_CALLS=1.5

# --- Gmail SMTP (alerts) ----------------------------------------------------
# Requires 2-Step Verification on the Google account, then an App Password:
#   https://myaccount.google.com/apppasswords
# Use the 16-character app password below — NOT your normal Google password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
# Optional overrides; both default to SMTP_USER.
MAIL_FROM=
MAIL_TO=

# --- IFTTT (phone notification) ---------------------------------------------
# Create an applet: "Email" trigger -> "Send a notification from the IFTTT app".
#   https://ifttt.com/connect/email/if_notifications
# The trigger fires on mail sent FROM the address registered with IFTTT, so
# SMTP_USER must be that same Gmail address. Set the applet's tag to match.
IFTTT_ENABLED=true
IFTTT_TRIGGER_EMAIL=trigger@applet.ifttt.com
IFTTT_HASHTAG=#flight

# Master switch — set false to record changes without sending any mail.
NOTIFICATIONS_ENABLED=true

# Prepended to every outgoing email subject, e.g.
#   PFT KL1705 AMS-LIS DELAYED +45min
# Handy for Gmail filters. Leave empty for no prefix.
EMAIL_SUBJECT_PREFIX=PFT

# --- Polling cadence (rarely needs changing) --------------------------------
POLL_FAR_OUT_HOURS=168        # sanity check interval when >24h from departure
POLL_WITHIN_24H_MINUTES=60
POLL_WITHIN_2H_MINUTES=10
POLL_AIRBORNE_MINUTES=5
POLL_RETRY_MINUTES=30
POLL_ABANDON_AFTER_HOURS=12

# --- App --------------------------------------------------------------------
# Port on the host. 8080 -> http://<host-ip>:8080
# Set to 80 to reach it at http://<host-ip>/ with no port suffix.
HOST_PORT=8080

TIMEZONE=Europe/Brussels
DATABASE_URL=sqlite:///./data/flights.db
LOG_LEVEL=INFO
